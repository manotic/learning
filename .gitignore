# Docker
# Excludes Docker-related files that are generated or specific to a local environment.
.env
.env.local
.env.*.local
docker-compose.override.yml

# Vendor
# This directory contains all Composer-managed dependencies. These should not be committed to Git, as they can be re-installed using `composer install`.
/vendor/

# Web Project Files
# These are cache, log, and session files that are generated at runtime and should not be part of the version control.
/var/cache/
/var/log/
/var/sessions/
# /public/build/
# /public/bundles/

# phpMyAdmin
# Excludes phpMyAdmin configuration files that are specific to your local setup.
/phpmyadmin/config.inc.php

# IDEs and OS
# Excludes files generated by various IDEs and operating systems.
.idea/
.vscode/
.DS_Store
Thumbs.db
docker/storage/mysql/
docker/storage/
